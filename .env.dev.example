# Development Environment Template
# Copy this file to .env.dev and customize for your development environment
# Usage: docker-compose up -d (uses .env.dev by default)

# PostgreSQL Configuration
POSTGRES_DB=college_dev_db
POSTGRES_USER=college_dev_user
POSTGRES_PASSWORD=dev_password_123

# MongoDB Configuration
MONGO_INITDB_DATABASE=college_dev_logs

# Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/college_dev_db
SPRING_DATASOURCE_USERNAME=college_dev_user
SPRING_DATASOURCE_PASSWORD=dev_password_123
SPRING_PROFILES_ACTIVE=dev

# Development-specific settings
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_MY_COLLEGEMANAGEMENT=DEBUG
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
