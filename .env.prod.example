# Production Environment Variables - EXAMPLE ONLY
# Never commit this file! Use cloud secret management instead.
# For reference: https://docs.microsoft.com/en-us/azure/key-vault/

# PostgreSQL Configuration
POSTGRES_DB=college_prod_db
POSTGRES_USER=college_prod_user
POSTGRES_PASSWORD=ChangeMe_Use_Strong_Password_12345!@#

# MongoDB Configuration
MONGO_INITDB_DATABASE=college_prod_logs

# Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://college-prod-db.postgres.database.azure.com:5432/college_prod_db
SPRING_DATASOURCE_USERNAME=college_prod_user@college-prod-db
SPRING_DATASOURCE_PASSWORD=ChangeMe_Use_Strong_Password_12345!@#
SPRING_PROFILES_ACTIVE=prod

# Application Configuration
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_MY_COLLEGEMANAGEMENT=INFO
SPRING_JPA_SHOW_SQL=false
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
